{
  "name": "jingwei",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "start": "node scripts/start.ts",
    "build": "node scripts/build.ts",
    "typecheck": "npm run typegen -w @jingwei/web && tsc --noEmit",
    "test": "node --import ./scripts/test-env.ts --test tests/*.test.ts",
    "replay:rule": "node scripts/replay-rule.ts",
    "test:storage": "node --import ./scripts/test-env.ts --test tests/storage-isolation.test.ts tests/maintenance-startup.test.ts",
    "collect": "node apps/worker/src/main.ts --once",
    "worker": "node apps/worker/src/main.ts",
    "build:keychain": "node scripts/build-keychain.ts",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "desktop:prepare": "npm run build && npm run desktop:compile && node desktop/prepare.mjs",
    "desktop:dev": "electron .",
    "desktop:mac": "electron-builder --mac dmg zip --arm64",
    "desktop:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.5",
    "isbot": "5.2.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "40.10.6",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3"
  },
  "version": "1.0.0-rc.5",
  "description": "经纬财经阅读与研究",
  "main": "desktop/main.mjs",
  "author": "经纬"
}
